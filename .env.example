# UA Market configuration. Copy to .env: `cp .env.example .env`.
# docker compose reads this file for every service (env_file) and for the host ports below.
# Values marked LOCAL are for a laptop run and must be replaced before a public deployment.
#
# Check that every setting the code reads is listed here: python tools/check_env.py

# ---- Docker compose (host side) ----
# Ports published on the host. Change one when something else already listens there.
APP_HOST_PORT=8000
WEB_HOST_PORT=3000
MAILPIT_UI_PORT=8025
# Which file the containers read (the e2e script points this at its own copy).
UAMARKET_ENV_FILE=.env
# Database password for the compose Postgres (LOCAL). Production: a long random value.
POSTGRES_PASSWORD=heritage

# ---- Production only (docker-compose.prod.yml, docs/LAUNCH-RUNBOOK.md) ----
# The shop's domain; Caddy gets its TLS certificate for it. uamarket.com belongs to someone else.
SHOP_DOMAIN=
# Empty = a real certificate. "tls internal" = Caddy's own CA, for a local rehearsal only.
CADDY_TLS=
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Nightly database and photo backups in the `backups` volume
BACKUP_HOUR_UTC=7
BACKUP_KEEP_DAYS=14

# ---- API (app/) ----
# Inside compose the app and scheduler get DATABASE_URL pointing at the db service; this
# value is for running the API without Docker.
DATABASE_URL=sqlite:///./heritage_fulfillment.db
SHOPIFY_CLIENT_SECRET=replace-with-shopify-app-client-secret
EDGE_SHARED_TOKEN=dev-only-shared-token
EDGE_DEVICE_TOKEN=provision-via-admin-api
EDGE_DEVICE_ID=LOCKER-PLC-01
SITE_ID=garage-ottawa-01
EASYPOST_API_KEY=
# Label buying in /admin needs EASYPOST_API_KEY and the address parcels leave from, as EasyPost
# address JSON, e.g. {"name":"...","street1":"...","city":"...","state":"ON","zip":"...","country":"CA","phone":"..."}.
# Empty = /admin offers tracking entry only.
SHIP_FROM_ADDRESS_JSON=
EDGE_SITE=default
# true only on a laptop: skips API keys and lets the API create tables without Alembic
ALLOW_INSECURE_DEV=false
OPERATOR_API_KEY=replace-with-long-random-operator-key
ADMIN_API_KEY=replace-with-long-random-admin-key
# ---- Owner admin at /admin on the storefront ----
# Generate both with: python3 tools/admin_password_hash.py  (empty = /admin shows "not set up")
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# How long sign-in stays locked after 5 wrong passwords from one address (seconds, software default 900)
ADMIN_LOGIN_LOCK_SECONDS=900
# Header that carries the visitor's address when a tunnel or CDN sits in front (e.g. cf-connecting-ip).
# Empty = the right-most X-Forwarded-For entry, which is right behind Caddy alone.
ADMIN_CLIENT_IP_HEADER=
# Product photos uploaded in /admin: stored here (a docker volume in compose), served at /media/.
MEDIA_ROOT=./media
# Largest photo the admin accepts, in megabytes (software default 15).
MEDIA_MAX_UPLOAD_MB=15
LOCKER_DRIVER=simulated
LOCKER_MODBUS_HOST=192.168.1.50
LOCKER_MODBUS_PORT=502
LOCKER_MODBUS_DEVICE_ID=1
LOCKER_UNLOCK_PULSE_MS=1500
LOCKER_UNLOCK_VERIFY_TIMEOUT_MS=750
LOCKER_MODBUS_MAP_JSON={"BAY-CP":{"inner_gate_di":0,"outer_door_di":1,"lock_feedback_di":2,"unlock_coil":0},"BAY-OTHER":{"inner_gate_di":0,"outer_door_di":3,"lock_feedback_di":4,"unlock_coil":1},"BAY-OVERFLOW":{"inner_gate_di":0,"outer_door_di":5,"lock_feedback_di":6,"unlock_coil":2}}
LOCKER_EDGE_SITE=garage-ottawa-01
LOCKER_EDGE_DEVICE_ID=LOCKER-PLC-01
COMMISSIONING_ENABLED=false
COMMISSIONING_DEVICE_MAX_AGE_SECONDS=15
# Courier and pickup-code door limits (software defaults)
COURIER_PIN_ATTEMPTS_PER_WINDOW=30
COURIER_PIN_ATTEMPT_WINDOW_SECONDS=600
COURIER_PIN_MAX_FAILURES=5
COURIER_PIN_FAILURE_WINDOW_SECONDS=900
COURIER_PIN_LOCKOUT_SECONDS=900
COURIER_PIN_IP_MAX_FAILURES=15
COURIER_PIN_IP_LOCKOUT_SECONDS=900
# Shared by Caddy, web and the API (production compose): the API believes the visitor address
# the storefront server passes on only when this matches. Generate: openssl rand -hex 32.
# Empty = every storefront request counts under the web server's own address.
INTERNAL_PROXY_SECRET=
# Advanced, for a deployment without the secret above: proxy addresses whose X-Forwarded-For
# the API believes. Leave empty with the production compose.
TRUSTED_PROXY_IPS=
EDGE_COMMISSIONING_ENABLED=false
LOCKER_SNAPSHOT_INTERVAL_SECONDS=15
LOCKER_MODBUS_TIMEOUT=3

# ---- Storefront (web/ + public API) ----
# Base URL of the storefront as a browser reaches it (Stripe return URLs, emails)
WEB_BASE_URL=http://localhost:3000
# Interac e-Transfer recipient. Empty, or a placeholder such as pay@uamarket.local
# (.local/.test/.invalid/example.*), hides e-Transfer as a payment method.
ETRANSFER_EMAIL=
# PayPal (Orders v2 + JS SDK v6). Offered first when both the client id and the secret are set.
# Get them at https://developer.paypal.com/dashboard/applications/sandbox (a free sandbox app).
# PAYPAL_ENV=sandbox moves test money only; the API refuses sandbox while SHOP_CATALOGUE_STATUS=live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Webhook id from the same app (Sandbox Webhooks -> Add Webhook -> https://<shop>/webhooks/paypal,
# events CHECKOUT.ORDER.APPROVED and PAYMENT.CAPTURE.*). Without it webhooks are refused; the
# browser capture still works.
PAYPAL_WEBHOOK_ID=
# Override of the PayPal REST base URL (tests and proxies only). Empty = sandbox or live by PAYPAL_ENV.
PAYPAL_API_BASE=

# ---- Agents: the shopping concierge and the owner's PayPal desk ----
# Any OpenAI-compatible /chat/completions server with tool calling. Default: Ollama Cloud.
# A local Ollama works too: AI_BASE_URL=http://host.docker.internal:11434/v1 AI_MODEL=qwen3:30b
# Empty AI_API_KEY with a remote URL switches both agents off (the shop works without them).
AI_BASE_URL=https://ollama.com/v1
AI_MODEL=gpt-oss:120b
AI_API_KEY=
# Public concierge limits: turns per visitor per 10 minutes, and per day for everyone.
AGENT_TURNS_PER_10MIN=30
AGENT_DAILY_TURNS=1500
# Most tool calls the concierge may make for one answer.
AI_MAX_TOOL_ROUNDS=6

# Card payments through Stripe Checkout. Offered only when BOTH are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# `fake` = local test card page, no money moves (LOCAL only). The API refuses to start with
# it while WEB_INDEXABLE=true or SHOP_CATALOGUE_STATUS=live. Empty = real Stripe settings.
# With no payment method at all the checkout says the shop is not taking orders yet.
PAYMENT_PROVIDER=
# How long placing an order holds its stock while unpaid (minutes, software default)
ORDER_HOLD_MINUTES=60
# Shown in the footer / "How it works". Placeholder addresses count as unset.
SHOP_CONTACT_EMAIL=
# Shipping within Canada (CAD); free over the threshold
SHIPPING_FLAT_CAD=12.00
SHIPPING_FREE_OVER_CAD=150.00
# Locker pickup.
# PICKUP_ADDRESS is the gate: while it is empty the checkout does not offer pickup
# at all, whatever PICKUP_ENABLED says, and every page and machine surface says
# pickup is switched off. There is no default, because nobody but the owner knows
# where the locker is. See docs/OWNER-ACTIONS.md section 8.
PICKUP_ADDRESS=
PICKUP_ENABLED=true
PICKUP_LABEL=Locker pickup
PICKUP_LABEL_UK=Самовивіз із локера
PICKUP_PROVINCE=ON
# When the address can be reached, free text, shown to the buyer with their code
PICKUP_HOURS=
SHOP_PICKUP_HOURS_UK=
# One more line the buyer needs at the door: lane, buzzer, parking
PICKUP_NOTE=
# How long a buyer's one-time bay code opens the bay
PICKUP_CODE_VALID_HOURS=72
# Zone the code's expiry is printed in, e.g. America/Toronto. UTC is labelled as UTC.
SHOP_TIMEZONE=UTC
# Sales tax (app/services/tax.py). unregistered = no tax line (a small supplier that has not
# registered for GST/HST); gst_hst_registered = GST or HST by province of delivery, as named
# lines; custom = TAX_RATES_JSON. Empty = custom when TAX_RATES_JSON is set, else unregistered.
SHOP_TAX_MODE=
# gst_hst_registered only: provinces where the shop is also registered for the provincial tax
# (BC PST, MB RST, SK PST, QC QST), comma-separated. Empty = none.
SHOP_PST_REGISTERED_PROVINCES=
# Printed on the order page and in the order email when set, e.g. 123456789 RT0001
SHOP_GST_NUMBER=
# custom mode: one sales tax rate per province of delivery, e.g. {"ON":0.13}
TAX_RATES_JSON=
# Provinces the shop does not ship to, comma-separated. Empty = QC (no French storefront yet);
# "none" = ship to every province. Stated on the shipping page, refused at checkout.
SHOP_SHIP_EXCLUDE_PROVINCES=QC
# Version (or date) of the terms of sale in force; the order email links the terms with it.
SHOP_TERMS_VERSION=

# ---- Order email (app/services/mailer.py) ----
# With SMTP_HOST or MAIL_FROM empty the mailer is DISABLED: nothing is sent, nothing
# fails, and the message that would have gone out is written to the log. The
# storefront reads this state and stops promising an email it cannot send.
# A placeholder MAIL_FROM also disables it, except toward a local mail catcher.
#
# LOCAL: the values below send every email to Mailpit (docker compose service `mailpit`),
# readable at http://localhost:8025. For production use the provider's host, port 587,
# SMTP_SECURITY=starttls, a login, and a MAIL_FROM on the shop's own domain.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=none
SMTP_TIMEOUT_SECONDS=20
MAIL_FROM=UA Market <shop@uamarket.local>
MAIL_REPLY_TO=
SHOP_NAME=UA Market
# Refuse to mail an order older than this many days (a queue drained late stays quiet)
ORDER_MAIL_MAX_AGE_DAYS=14
# Write the text of an unsent message to the log (one-time codes are cut out). Default off.
MAIL_LOG_BODIES=false
# The scheduler container runs the mail and stock-hold sweep this often (seconds)
SCHEDULER_INTERVAL_SECONDS=300

# ---- Locker and edge hardening ----
LOCKER_PIN_KDF_ITERATIONS=200000
LOCKER_UNLOCK_RELEASE_ATTEMPTS=3
LOCKER_UNLOCK_RELEASE_RETRY_MS=100
EDGE_DISABLE_BAY_ON_COIL_FAULT=true
EDGE_CREDENTIAL_RECHECK_SECONDS=5
EDGE_COMMAND_MAX_ATTEMPTS=5
EDGE_COMMAND_RETRY_BACKOFF_SECONDS=5
# Which device owns which bay, e.g. {"LOCKER-PLC-01":["BAY-CP","BAY-OTHER"]}
EDGE_BAY_OWNERS_JSON=
EDGE_WS_URL=ws://127.0.0.1:8000/edge/ws
EDGE_STATE_DB=edge-state.db

# ---- Storefront (web/) ----
# Read by the Next.js app (compose sets API_URL=http://app:8000 itself).
API_URL=http://127.0.0.1:8010
# Anything but "true" serves robots.txt as deny-all and an empty sitemap
WEB_INDEXABLE=false
# "true" uses the proposed search titles and description (web/lib/i18n.seo.ts PROPOSED_SEO) on the
# front page and the shop. Off until the owner approves the wording.
SEO_USE_PROPOSED_TITLES=false
# "live" only once the real assortment replaces the seeded placeholder one. Read by the web
# and the API: until then every order is a demo order and the pages say so.
SHOP_CATALOGUE_STATUS=
# Where parcels leave from, e.g. "Ottawa, Ontario" / "Оттава, Онтаріо". Empty = no city is
# named anywhere ("Shipped across Canada").
SHOP_BASE_PLACE=
SHOP_BASE_PLACE_UK=
# The law the terms of sale name
SHOP_GOVERNING_PLACE=
SHOP_GOVERNING_PLACE_UK=
# Registered seller name. Empty = the trading name, marked as not the legal name.
SHOP_LEGAL_NAME=
SHOP_LEGAL_NAME_UK=
# Business address printed in the seller block on terms, privacy and how-it-works. Empty = "not published yet".
SHOP_BUSINESS_ADDRESS=
# Who answers privacy requests. Empty = the contact address. Placeholder addresses count as unset.
SHOP_PRIVACY_EMAIL=
# Named on the privacy page as the processors list. Empty hosting = "not published yet";
# the email provider defaults to the SMTP host name.
SHOP_HOSTING_PROVIDER=
MAIL_PROVIDER_NAME=
# Free-text delivery estimate, when the owner wants one instead of day ranges
SHOP_DELIVERY_ESTIMATE=
SHOP_DELIVERY_ESTIMATE_UK=
SHOP_REFUND_BUSINESS_DAYS=
SHOP_LOCKER_HOLD_DAYS=
# Retention periods the privacy page prints (software defaults 7 years, 24 and 24 months)
SHOP_ORDER_RECORD_YEARS=
SHOP_MESSAGE_RETENTION_MONTHS=
SHOP_CANCELLED_RETENTION_MONTHS=
# Policy figures. Empty means the page says the value is not published yet
# instead of inventing one. See docs/OWNER-ACTIONS.md.
SHOP_CARRIER=
SHOP_PROCESSING_DAYS_MIN=
SHOP_PROCESSING_DAYS_MAX=
SHOP_HANDLING_DAYS=
SHOP_TRANSIT_DAYS=
SHOP_RETURN_WINDOW_DAYS=
SHOP_RETURN_METHOD=
SHOP_RETURN_FEES=
# Where the pickup locker is, e.g. {"line1":"…","city":"Ottawa","province":"ON","postal_code":"K1A 0B1"}
SHOP_PICKUP_ADDRESS_JSON=
SHOP_PICKUP_HOURS=
# Price rails on the shop page, e.g. 50,120,250
SHOP_PRICE_BANDS_CAD=
# Optional ttf/otf for the Open Graph image title
OG_TITLE_FONT_PATH=

# UA Market behind Caddy (docker-compose.prod.yml).
#
# Automatic HTTPS for SHOP_DOMAIN. Only the Stripe webhook reaches the API directly; every
# other path is the storefront, which talks to the API over the compose network.
# The storefront believes X-Real-IP only when X-Internal-Proxy-Secret matches, and Caddy
# overwrites both headers on every request, so a visitor cannot supply either.
{
	admin off
}

{$SHOP_DOMAIN} {
	{$CADDY_TLS}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /webhooks/stripe {
		reverse_proxy app:8000
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Internal-Proxy-Secret {$INTERNAL_PROXY_SECRET}
			header_up -X-Client-IP
		}
	}
}
